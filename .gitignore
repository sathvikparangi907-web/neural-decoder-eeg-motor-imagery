# generated scratch — regenerable with the pdftoppm commands in review2/HANDOFF.md
review2/_qa-renders/

# raw dataset and cached tensors — large, downloaded by phase3/data.py
data/*
# the 18 raw .mat files are tracked verbatim, which the CC BY-ND licence allows;
# SHA256SUMS pins them. cache/ is a processed derivative: not redistributable
# under that licence, and rebuilt from data/ by phase3/data.py in one command.
!data/SHA256SUMS
!data/*.mat
!data/trials.csv
!data/README.md
# the CSV views of the recordings: GitHub renders these as tables, the .mat files
# it refuses to preview at all. Rebuilt by phase3/.../to_csv.py.
!data/csv/
!data/csv/*
cache/

node_modules/
__pycache__/
*.pyc
desktop.ini

# the stale nested copy of this repository: it was tracked as a submodule link
# with no .gitmodules, so GitHub showed a folder that clicked through to nothing
phase2-eeg-project/

# Phase 2 scratch: page renders of Phase2_Solution_Design.pdf used for proofreading
