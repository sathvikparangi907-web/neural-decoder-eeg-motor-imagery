# generated scratch — regenerable with the pdftoppm commands in review2/HANDOFF.md
review2/_qa-renders/

# raw dataset and cached tensors — large, downloaded by phase3/data.py
data/*
# the 18 raw .mat files are tracked verbatim, which the CC BY-ND licence allows;
# SHA256SUMS pins them. cache/ is a processed derivative: not redistributable
# under that licence, and rebuilt from data/ by phase3/data.py in one command.
!data/SHA256SUMS
!data/*.mat
!data/trials.csv
cache/

node_modules/
__pycache__/
*.pyc
desktop.ini
